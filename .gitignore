# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
.env.txt

# Supabase CLI local state
supabase/.temp/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# git bundles used to hand commits over by hand — they hold this repo's own
# history, so committing one back into it serves no purpose
*.bundle

# SQL blocks pulled out of schema.sql to paste into the Supabase editor.
# schema.sql is the original; a committed copy would drift from it, and a
# stale copy of a migration is worse than no copy at all. Regenerate with:
#   sed -n '/in-app payment via Stripe Connect/,$p' supabase/schema.sql
stripe-connect.sql
